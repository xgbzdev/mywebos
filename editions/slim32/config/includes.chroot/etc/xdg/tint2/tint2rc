# B2L Slim top bar: Home button | open windows | tray | clock
panel_items = LTSC
panel_size = 100% 28
panel_margin = 0 0
panel_padding = 4 2 6
panel_background_id = 1
panel_position = top center horizontal
panel_layer = top
panel_dock = 0
wm_menu = 0
panel_monitor = all
autohide = 0
strut_policy = follow_size
font_shadow = 0
mouse_effects = 1

rounded = 0
border_width = 0
background_color = #000000 75
border_color = #000000 0

rounded = 3
border_width = 0
background_color = #ffffff 18
border_color = #ffffff 0

launcher_padding = 2 2 4
launcher_background_id = 0
launcher_icon_size = 20
launcher_item_app = /usr/share/applications/b2l-startmenu.desktop

taskbar_mode = single_desktop
taskbar_padding = 4 0 4
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 160 22
task_padding = 4 2 4
task_font = Open Sans 9
task_font_color = #dddddd 100
task_active_font_color = #ffffff 100
task_background_id = 0
task_active_background_id = 2
mouse_left = toggle_iconify
mouse_middle = close
mouse_right = close

systray_padding = 2 0 4
systray_background_id = 0
systray_icon_size = 18

time1_format = %H:%M
time1_font = Open Sans Bold 10
clock_font_color = #ffffff 100
clock_padding = 6 0
clock_background_id = 0
