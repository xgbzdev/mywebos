# Firefox OS boot splash: glowing globe, orbiting ring, title and pulsing dots
Window.SetBackgroundTopColor(0.30, 0.62, 0.17);
Window.SetBackgroundBottomColor(0.07, 0.30, 0.09);

W = Window.GetWidth(); H = Window.GetHeight();
cx = W / 2; cy = H / 2 - 50;

glow.image = Image("glow.png");
glow.sprite = Sprite(glow.image);
glow.sprite.SetPosition(cx - glow.image.GetWidth() / 2, cy - glow.image.GetHeight() / 2, 0);

ring.image = Image("ring.png");
ring.sprite = Sprite();
ring.sprite.SetZ(1);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2, 2);
logo.sprite.SetOpacity(0);

title.image = Image("title.png");
title.sprite = Sprite(title.image);
title.sprite.SetPosition(cx - title.image.GetWidth() / 2, cy + 140, 2);
title.sprite.SetOpacity(0);

dot_image = Image("dot.png");
for (i = 0; i < 3; i++) {
  dot[i] = Sprite(dot_image);
  dot[i].SetPosition(cx - 34 + i * 28, cy + 210, 2);
  dot[i].SetOpacity(0.2);
}

t = 0;
fun refresh_callback () {
  t++;
  # globe fades and "pops" in
  a = Math.Min(t / 40, 1);
  logo.sprite.SetOpacity(a);
  # breathing glow
  glow.sprite.SetOpacity(0.55 + 0.45 * Math.Sin(t * 0.05));
  # ring orbits the globe
  r = ring.image.Rotate(t * 0.08);
  ring.sprite.SetImage(r);
  ring.sprite.SetPosition(cx - r.GetWidth() / 2, cy - r.GetHeight() / 2, 1);
  ring.sprite.SetOpacity(a);
  # title slides up while fading in
  ta = Math.Min(Math.Max((t - 25) / 35, 0), 1);
  title.sprite.SetOpacity(ta);
  title.sprite.SetY(cy + 160 - 20 * ta);
  # loading dots
  for (i = 0; i < 3; i++) {
    dot[i].SetOpacity(0.25 + 0.75 * (Math.Sin(t * 0.12 - i * 0.9) + 1) / 2);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# keep password prompts usable (e.g. encrypted disks)
fun display_normal_callback () { }
Plymouth.SetDisplayNormalFunction(display_normal_callback);
