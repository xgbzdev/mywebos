#!/bin/sh
mkdir -p "$HOME/.cache"; exec >>"$HOME/.cache/fxos-session.log" 2>&1
# Per-login setup: live desktop icons, saved keyboard, welcome wizard.
KB="$HOME/.config/firefoxos/keyboard"
[ -f "$KB" ] && setxkbmap "$(cat "$KB")"
DESK=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
mkdir -p "$DESK"
if grep -q "boot=live" /proc/cmdline; then
    # Try mode: never lock or blank the screen (e.g. during a long install)
    pkill -x light-locker 2>/dev/null || true
    xset s off -dpms 2>/dev/null || true
    xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/dpms-enabled -n -t bool -s false 2>/dev/null || true
    xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/lock-screen-suspend-hibernate -n -t bool -s false 2>/dev/null || true
    xfconf-query -c xfce4-screensaver -p /lock/enabled -n -t bool -s false 2>/dev/null || true
    for f in fxos-install; do
        cp /usr/share/applications/$f.desktop "$DESK/" && sed -i '/^NoDisplay/d' "$DESK/$f.desktop"
        chmod +x "$DESK/$f.desktop"
        gio set "$DESK/$f.desktop" metadata::trusted true 2>/dev/null || true
    done
fi
# The live system drops a Debian installer launcher on the desktop a bit later: keep removing it
( for i in $(seq 1 20); do rm -f "$DESK"/*install-debian* "$DESK"/calamares*; sleep 3; done ) &
for f in thunar firefox-esr fxos-marketplace; do
    [ -f "$DESK/$f.desktop" ] || { cp /usr/share/applications/$f.desktop "$DESK/" 2>/dev/null && chmod +x "$DESK/$f.desktop"; }
done
# Some installer launchers appear a little later: remove them for a while
( for i in 1 2 3 4 5 6; do sleep 10; rm -f "$DESK"/*install-debian*.desktop "$DESK"/calamares*.desktop; done ) &
sleep 2
# Set the Firefox OS wallpaper on every monitor xfdesktop knows about
for prop in $(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E "last-image$"); do
    xfconf-query -c xfce4-desktop -p "$prop" -s /usr/share/firefoxos/wallpapers/default.png
done
exec fxos-welcome --autostart
