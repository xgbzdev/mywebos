#!/usr/bin/env python3
"""Firefox OS welcome wizard: language, keyboard, network, apps, try-or-install."""
import os
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk  # noqa: E402

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".config", "firefoxos")
DONE_FLAG = os.path.join(STATE, "welcome-done")
LIVE = "boot=live" in open("/proc/cmdline").read()

LANGS = [
    ("en", "English", "en_US.UTF-8", "us"),
    ("it", "Italiano", "it_IT.UTF-8", "it"),
    ("el", "Ελληνικά", "el_GR.UTF-8", "gr"),
    ("es", "Español", "es_ES.UTF-8", "es"),
    ("fr", "Français", "fr_FR.UTF-8", "fr"),
    ("de", "Deutsch", "de_DE.UTF-8", "de"),
    ("pt", "Português", "pt_PT.UTF-8", "pt"),
    ("pl", "Polski", "pl_PL.UTF-8", "pl"),
]
KEYBOARDS = [("us", "English (US)"), ("gb", "English (UK)"), ("it", "Italiano"),
             ("gr", "Ελληνικά"), ("es", "Español"), ("fr", "Français"),
             ("de", "Deutsch"), ("pt", "Português"), ("br", "Português (Brasil)"),
             ("pl", "Polski"), ("ch", "Schweiz"), ("latam", "Latinoamérica")]

