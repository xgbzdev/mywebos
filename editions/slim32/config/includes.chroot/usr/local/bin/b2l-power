#!/bin/sh
# Start menu power buttons
say() { notify-send -i dialog-information "Firefox OS" "$1" 2>/dev/null; }
case "$1" in
    poweroff) systemctl poweroff ;;
    reboot)   systemctl reboot ;;
    logout)   openbox --exit ;;
    hibernate)
        if grep -q "boot=live" /proc/cmdline; then
            say "Hibernate works after Firefox OS is installed (it needs a swap partition as big as the RAM)."
        else
            systemctl hibernate 2>/dev/null || say "Hibernate needs a swap partition at least as big as the RAM."
        fi ;;
esac
