#!/bin/sh
# Make the home screen window look like a home screen: no frame, maximised,
# behind every other window, not in the task bar. (Firefox sets the window
# title late, so this is done once the window exists.)
for i in $(seq 1 300); do
    wid=$(wmctrl -l | awk '/B2L Home/ {print $1; exit}')
    if [ -n "$wid" ]; then
        xprop -id "$wid" -f _MOTIF_WM_HINTS 32c -set _MOTIF_WM_HINTS "2, 0, 0, 0, 0"
        wmctrl -i -r "$wid" -b add,below,skip_taskbar,skip_pager
        wmctrl -i -r "$wid" -b add,maximized_vert,maximized_horz
        exit 0
    fi
    sleep 1
done
