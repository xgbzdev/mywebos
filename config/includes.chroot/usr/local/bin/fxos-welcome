CSS = b"""
.header { background-image: linear-gradient(90deg, #ff9a1f, #e8481c); color: white; padding: 18px 22px; }
.header .step { font-size: 9pt; opacity: .9; }
.header .title { font-size: 17pt; }
.header .sub { font-size: 10pt; opacity: .95; }
.lang-btn { min-width: 150px; min-height: 34px; }
.lang-btn:checked { background: #e3f6fc; border-color: #00a5d6; }
.primary { background-image: none; background-color: #00a5d6; color: white; border-color: #0095c2; }
.footer { background: #f4f4f4; padding: 10px 18px; }
"""


def run(*cmd):
    try:
        subprocess.Popen(cmd, start_new_session=True)
    except FileNotFoundError:
        pass


class Welcome(Gtk.Window):
    def __init__(self):
        super().__init__(title="Firefox OS")
        self.set_default_size(560, 330)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_from_file("/usr/share/firefoxos/icons/firefoxos.svg") \
            if os.path.exists("/usr/share/firefoxos/icons/firefoxos.svg") else None
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        env = os.environ.get("LANG", "en")[:2]
        self.lang = env if env in T else "en"
        self.start_lang = self.lang
        self.kbd = next((k for c, _, _, k in LANGS if c == self.lang), "us")
        self.step = 0
        self.root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(self.root)
        self.render()

    def t(self, i):
        return T[self.lang][i]

    # ---- layout ----
    def render(self):
        for c in self.root.get_children():
            self.root.remove(c)
        titles = [(0, 1), (4, 5), (4, 5), (7, 8), (11, 12)]
        ti, si = titles[self.step]
        title = self.t(2) if self.step == 1 else self.t(ti)
        sub = self.t(3) if self.step == 1 else self.t(si)
        if self.step == 3:
            sub = ""

        head = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        head.get_style_context().add_class("header")
        for txt, cls in ((self.t(18).format(self.step + 1), "step"), (title, "title"), (sub, "sub")):
            lb = Gtk.Label(label=txt, xalign=0)
            lb.get_style_context().add_class(cls)
            head.pack_start(lb, False, False, 0)
        self.root.pack_start(head, False, False, 0)

        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=18)
        getattr(self, "page%d" % self.step)(body)
        self.root.pack_start(body, True, True, 0)

        foot = Gtk.Box(spacing=8)
        foot.get_style_context().add_class("footer")
        if self.step > 0:
            back = Gtk.Button(label=self.t(17))
            back.connect("clicked", lambda *_: self.go(-1))
            foot.pack_start(back, False, False, 0)
        dots = Gtk.Label(label=" ".join("●" if i == self.step else "○" for i in range(5)))
        foot.set_center_widget(dots)
        if self.step < 4:
            nxt = Gtk.Button(label=self.t(16))
            nxt.get_style_context().add_class("primary")
            nxt.connect("clicked", lambda *_: self.go(1))
            foot.pack_end(nxt, False, False, 0)
        self.root.pack_end(foot, False, False, 0)
        self.show_all()

    def go(self, d):
        self.step = max(0, min(4, self.step + d))
        self.render()

    # ---- pages ----
    def page0(self, box):
        grid = Gtk.Grid(column_spacing=8, row_spacing=8)
        group = None
        for i, (code, name, _, _) in enumerate(LANGS):
            b = Gtk.RadioButton.new_with_label_from_widget(group, name)
            group = group or b
            b.set_mode(False)
            b.get_style_context().add_class("lang-btn")
            b.set_active(code == self.lang)
            b.connect("toggled", self.on_lang, code)
            grid.attach(b, i % 3, i // 3, 1, 1)
        box.pack_start(grid, False, False, 0)

    def on_lang(self, btn, code):
        if not btn.get_active():
            return
        self.lang = code
        self.kbd = next(k for c, _, _, k in LANGS if c == code)
        self.apply_keyboard()
        self.render()

    def page1(self, box):
        combo = Gtk.ComboBoxText()
        for code, name in KEYBOARDS:
            combo.append(code, name)
        combo.set_active_id(self.kbd)
        combo.connect("changed", lambda c: (setattr(self, "kbd", c.get_active_id()),
                                            self.apply_keyboard()))
        box.pack_start(combo, False, False, 0)
        box.pack_start(Gtk.Entry(placeholder_text=self.t(3)), False, False, 0)

    def page2(self, box):
        b = Gtk.Button(label=self.t(6))
        b.connect("clicked", lambda *_: run("nm-connection-editor"))
        box.pack_start(b, False, False, 0)

    def page3(self, box):
        lb = Gtk.Label(label=self.t(8), xalign=0, wrap=True)
        box.pack_start(lb, False, False, 0)
        row = Gtk.Box(spacing=8)
        for txt, cmd in ((self.t(9), "fxos-marketplace"), (self.t(10), "fxos-emulators")):
            b = Gtk.Button(label=txt)
            b.connect("clicked", lambda _b, c=cmd: run(c))
            row.pack_start(b, False, False, 0)
        box.pack_start(row, False, False, 0)

    def page4(self, box):
        tips = Gtk.Label(label="\n".join("•  " + l for l in self.t(13).split("\n")),
                         xalign=0, wrap=True)
        box.pack_start(tips, False, False, 0)
        row = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER)
        keep = Gtk.Button(label=self.t(14) if LIVE else self.t(19))
        keep.connect("clicked", lambda *_: self.finish(False))
        row.pack_start(keep, False, False, 0)
        if LIVE:
            inst = Gtk.Button(label=self.t(15))
            inst.get_style_context().add_class("primary")
            inst.connect("clicked", lambda *_: self.finish(True))
            row.pack_start(inst, False, False, 0)
        box.pack_start(row, False, False, 12)

    # ---- actions ----
    def apply_keyboard(self):
        run("setxkbmap", self.kbd)
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, "keyboard"), "w") as f:
            f.write(self.kbd)

    def save_language(self):
        loc = next(l for c, _, l, _ in LANGS if c == self.lang)
        # ~/.xsessionrc is read by Debian's Xsession on every login.
        rc = os.path.join(HOME, ".xsessionrc")
        lines = []
        if os.path.exists(rc):
            lines = [l for l in open(rc) if "# fxos-lang" not in l and "# fxos-kbd" not in l]
        lines.append('export LANG=%s LANGUAGE=%s  # fxos-lang\n' % (loc, self.lang))
        lines.append('setxkbmap %s 2>/dev/null  # fxos-kbd\n' % self.kbd)
        with open(rc, "w") as f:
            f.writelines(lines)
        # Installed systems: also tell AccountsService (used by LightDM).
        run("dbus-send", "--system", "--print-reply", "--dest=org.freedesktop.Accounts",
            "/org/freedesktop/Accounts/User%d" % os.getuid(),
            "org.freedesktop.Accounts.User.SetLanguage", "string:" + loc)

    def finish(self, install):
        os.makedirs(STATE, exist_ok=True)
        open(DONE_FLAG, "w").close()
        self.save_language()
        if install:
            run("fxos-install")
        elif self.lang != self.start_lang:
            dlg = Gtk.MessageDialog(transient_for=self, buttons=Gtk.ButtonsType.YES_NO,
                                    message_type=Gtk.MessageType.QUESTION, text=self.t(20))
            if dlg.run() == Gtk.ResponseType.YES:
                run("xfce4-session-logout", "--logout", "--fast")
            dlg.destroy()
        Gtk.main_quit()


if __name__ == "__main__":
    import sys
    # Live RAM home is wiped on reboot, so the wizard shows on every fresh live boot.
    if "--autostart" in sys.argv and os.path.exists(DONE_FLAG):
        sys.exit(0)
    w = Welcome()
    w.connect("destroy", Gtk.main_quit)
    Gtk.main()
