#!/bin/sh
# Runs inside the image while it is being built.
set -e

# ---- Identity -------------------------------------------------------------
cat > /etc/os-release <<'EOF'
PRETTY_NAME="Firefox OS (personal edition)"
NAME="Firefox OS"
VERSION_ID="2.0"
VERSION="2.0 (based on Debian 13)"
ID=firefoxos
ID_LIKE=debian
HOME_URL="https://www.mozilla.org/firefox/"
EOF
echo "firefoxos" > /etc/hostname
echo "Firefox OS 2.0 \n \l" > /etc/issue

# ---- Flathub for Linux apps -------------------------------------------------
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true

# ---- Default look: wallpaper, icons, LightDM greeter ------------------------
mkdir -p /etc/lightdm/lightdm-gtk-greeter.conf.d
cat > /etc/lightdm/lightdm-gtk-greeter.conf.d/50-firefoxos.conf <<'EOF'
[greeter]
background=/usr/share/firefoxos/wallpapers/default.png
theme-name=Adwaita
icon-theme-name=Papirus
font-name=Noto Sans 11
clock-format=%H:%M  %A, %B %d
indicators=~host;~spacer;~clock;~spacer;~language;~a11y;~power
EOF

# ---- Calamares installer branding -----------------------------------------
B=/etc/calamares/branding/debian/branding.desc
if [ -f "$B" ]; then
    sed -i \
      -e 's/^\(\s*productName:\).*/\1 "Firefox OS"/' \
      -e 's/^\(\s*shortProductName:\).*/\1 "Firefox OS"/' \
      -e 's/^\(\s*version:\).*/\1 "2.0"/' \
      -e 's/^\(\s*shortVersion:\).*/\1 "2.0"/' \
      -e 's/^\(\s*versionedName:\).*/\1 "Firefox OS 2.0"/' \
      -e 's/^\(\s*shortVersionedName:\).*/\1 "Firefox OS 2.0"/' \
      -e 's/^\(\s*bootloaderEntryName:\).*/\1 "FirefoxOS"/' \
      -e 's/^\(\s*sidebarBackground:\).*/\1 "#e8571c"/' \
      "$B"
    cp /usr/share/firefoxos/icons/firefoxos.svg /etc/calamares/branding/debian/firefoxos-logo.svg || true
fi
# The welcome wizard / Install icon launch Calamares through this wrapper
cat > /usr/local/bin/fxos-install <<'EOF'
#!/bin/sh
if command -v install-debian >/dev/null 2>&1; then exec install-debian; fi
exec pkexec calamares
EOF
chmod 755 /usr/local/bin/fxos-install

# ---- GRUB name on installed systems ------------------------------------------
if [ -f /etc/default/grub ]; then
    sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Firefox OS"/' /etc/default/grub
fi

# ---- Hide duplicate launchers so the Start menu matches Firefox OS -------------
for f in xfce4-mail-reader xfce4-web-browser xfce4-file-manager xfce4-terminal-emulator \
         xfce4-run xfce-backdrop-settings debian-xterm debian-uxterm; do
    [ -f /usr/share/applications/$f.desktop ] && \
        echo "NoDisplay=true" >> /usr/share/applications/$f.desktop || true
done

# ---- Firefox defaults -------------------------------------------------------
mkdir -p /etc/firefox/policies
cat > /etc/firefox/policies/policies.json <<'EOF'
{
  "policies": {
    "DontCheckDefaultBrowser": true,
    "OverrideFirstRunPage": "",
    "Preferences": {
      "intl.locale.requested": { "Value": "", "Status": "default" }
    }
  }
}
EOF

chmod 755 /usr/local/bin/fxos-* || true
update-desktop-database /usr/share/applications || true

# ==== Slim edition extras ====================================================
# Generate only the 8 supported languages (instead of locales-all)
cat > /etc/locale.gen <<'L'
en_US.UTF-8 UTF-8
en_GB.UTF-8 UTF-8
it_IT.UTF-8 UTF-8
el_GR.UTF-8 UTF-8
es_ES.UTF-8 UTF-8
fr_FR.UTF-8 UTF-8
de_DE.UTF-8 UTF-8
pt_PT.UTF-8 UTF-8
pl_PL.UTF-8 UTF-8
L
locale-gen

# Compressed RAM swap: makes 1-2 GB machines far less likely to freeze
if [ -f /etc/default/zramswap ]; then
    sed -i 's/^#\?ALGO=.*/ALGO=zstd/; s/^#\?PERCENT=.*/PERCENT=60/' /etc/default/zramswap
fi
systemctl enable zramswap.service 2>/dev/null || true
cat > /etc/sysctl.d/90-firefoxos-lowmem.conf <<'S'
vm.swappiness=100
vm.vfs_cache_pressure=150
S

# Default wallpaper everywhere (xfdesktop fallback + Debian desktop-base)
for f in /usr/share/images/desktop-base/default \
         /usr/share/images/desktop-base/desktop-background \
         /usr/share/backgrounds/xfce/xfce-shapes.svg \
         /usr/share/backgrounds/xfce/xfce-x.svg \
         /usr/share/backgrounds/xfce/xfce-verticals.png; do
    if [ -e "$f" ] || [ -L "$f" ]; then
        rm -f "$f"; ln -s /usr/share/firefoxos/wallpapers/default.png "$f"
    fi
done
mkdir -p /usr/share/images/desktop-base
ln -sf /usr/share/firefoxos/wallpapers/default.png /usr/share/images/desktop-base/default

# Firefox: lighter on RAM
mkdir -p /etc/firefox/policies
python3 - <<'P'
import json
p = "/etc/firefox/policies/policies.json"
d = json.load(open(p))
prefs = d["policies"].setdefault("Preferences", {})
for k, v in {"dom.ipc.processCount": 2, "browser.cache.memory.capacity": 32768,
             "browser.sessionhistory.max_total_viewers": 0,
             "extensions.pocket.enabled": False}.items():
    prefs[k] = {"Value": v, "Status": "default"}
json.dump(d, open(p, "w"), indent=2)
P
