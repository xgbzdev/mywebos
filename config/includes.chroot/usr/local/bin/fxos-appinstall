#!/usr/bin/env python3
"""Install / remove Firefox OS apps (manifest.webapp).

  fxos-appinstall app.zip                  packaged app
  fxos-appinstall path/to/manifest.webapp  unpacked packaged app
  fxos-appinstall https://site/manifest.webapp   hosted app
  fxos-appinstall --list | --remove ID
"""
import subprocess
import sys

sys.path.insert(0, "/usr/lib/firefoxos")
import fxosapps  # noqa: E402


import os  # noqa: E402

TT = {
    "en": dict(title="Install app", ask="Do you want to install “%s”?", by="by %s",
               install="Install", cancel="Cancel"),
    "it": dict(title="Installa app", ask="Vuoi installare “%s”?", by="di %s",
               install="Installa", cancel="Annulla"),
    "es": dict(title="Instalar app", ask="¿Quieres instalar “%s”?", by="de %s",
               install="Instalar", cancel="Cancelar"),
    "fr": dict(title="Installer l'appli", ask="Voulez-vous installer « %s » ?", by="par %s",
               install="Installer", cancel="Annuler"),
    "de": dict(title="App installieren", ask="Möchtest du „%s“ installieren?", by="von %s",
               install="Installieren", cancel="Abbrechen"),
}
T = TT.get(os.environ.get("LANG", "en")[:2], TT["en"])


def notify(title, body, icon="system-software-install"):
    subprocess.call(["notify-send", "-a", "Marketplace", "-i", icon, title, body])


def main(argv):
    quiet = "--quiet" in argv
    args = [a for a in argv if a != "--quiet"]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if args[0] == "--list":
        for a in fxosapps.list_apps():
            print("%-24s %-8s %s" % (a["id"], a["type"], a["name"]))
        return 0
    if args[0] == "--remove" and len(args) > 1:
        fxosapps.uninstall(args[1])
        return 0
    status = 0
    ask = not quiet and not sys.stdin.isatty()
    for src in args:
        if src.startswith("file://"):
            from urllib.parse import unquote, urlparse
            src = unquote(urlparse(src).path)
        try:
            if ask:
                import fxosui
                name, dev = fxosapps.peek(src)
                text = T["ask"] % name + ("\n" + T["by"] % dev if dev else "")
                if not fxosui.confirm(None, text, T["install"], T["cancel"], title=T["title"]):
                    continue
            meta = fxosapps.install(src)
            print("installed:", meta["id"], "-", meta["name"])
            if not quiet:
                notify(meta["name"], "Firefox OS app installed", meta.get("icon_file") or "firefoxos")
        except fxosapps.AppError as e:
            print("error:", e, file=sys.stderr)
            if not quiet:
                notify("Could not install app", str(e), "dialog-error")
            status = 1
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
