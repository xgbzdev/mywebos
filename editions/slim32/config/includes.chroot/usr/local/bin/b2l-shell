#!/bin/sh
# B2L shell: the home screen as a full-screen surface (not a normal window).
# It has its own small Firefox profile with every toolbar hidden; Openbox keeps
# it frameless, maximised and behind other windows (class "B2LHome").
# If it is closed or crashes, it comes straight back.
P="$HOME/.local/share/b2l/shell-profile"
mkdir -p "$P/chrome"
cat > "$P/user.js" <<'J'
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.sessionstore.max_resumed_crashes", 0);
user_pref("browser.startup.page", 0);
user_pref("browser.tabs.warnOnClose", false);
user_pref("browser.warnOnQuit", false);
user_pref("browser.download.useDownloadDir", true);
user_pref("permissions.default.geo", 0);
user_pref("dom.disable_beforeunload", true);
J
cat > "$P/chrome/userChrome.css" <<'C'
/* B2L home screen: no browser interface at all */
#TabsToolbar, #nav-bar, #PersonalToolbar, #sidebar-box, #sidebar-splitter,
#titlebar, #toolbar-menubar, #notifications-toolbar, #statuspanel,
#fullscr-toggler { visibility: collapse !important; }
C
while true; do
    firefox-esr --no-remote --class B2LHome --name B2LHome --profile "$P" "http://127.0.0.1:8090/"
    sleep 1
done
